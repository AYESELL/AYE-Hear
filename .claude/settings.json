  "agent": "ayehear-lead",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.ps1\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/core-rules.ps1\" || { echo 'core-rules: hook failed, core rules not re-injected' >&2; exit 1; }",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-task-check.ps1\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"G:/Repo/platform-tools/tools/ai-usage/Invoke-AiUsageHook.ps1\" -ConfigPath \"$CLAUDE_PROJECT_DIR/.claude/agent-roles.json\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/task-call-guard.ps1\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/powershell-ast-guard.ps1\"; rc=$?; if [ $rc -ne 0 ] && [ $rc -ne 2 ]; then echo 'powershell-ast-guard: hook failed, failing closed' >&2; exit 2; fi; exit $rc",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit|MultiEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/env-guard.ps1\"; rc=$?; if [ $rc -ne 0 ] && [ $rc -ne 2 ]; then echo 'env-guard: hook failed, failing closed' >&2; exit 2; fi; exit $rc",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/lead-write-guard.ps1\"; rc=$?; if [ $rc -ne 0 ] && [ $rc -ne 2 ]; then echo 'lead-write-guard: hook failed, failing closed' >&2; exit 2; fi; exit $rc",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__aye-task(-lead)?__.*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/task-mcp-role-guard.ps1\"; rc=$?; if [ $rc -ne 0 ] && [ $rc -ne 2 ]; then echo 'task-mcp-role-guard: hook failed, failing closed' >&2; exit 2; fi; exit $rc",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__aye-task(-lead)?__.*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"G:/Repo/platform-tools/tools/ai-usage/Invoke-AiUsageHook.ps1\" -ConfigPath \"$CLAUDE_PROJECT_DIR/.claude/agent-roles.json\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"G:/Repo/platform-tools/tools/ai-usage/Invoke-AiUsageHook.ps1\" -ConfigPath \"$CLAUDE_PROJECT_DIR/.claude/agent-roles.json\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
